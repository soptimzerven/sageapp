# ============================================
# PERSONAL INFORMATION PROTECTION
# These files contain local paths with usernames
# ============================================

# Flutter generated files containing local machine paths (CRITICAL - contains username)
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# ============================================
# IDE & EDITOR FILES
# May contain local paths and user preferences
# ============================================

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code (may contain local debug paths)
.vscode/

# Other editors
.atom/
*.swp
*.swo
*~

# ============================================
# OS-SPECIFIC FILES
# System metadata that may leak info
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================
# FLUTTER / DART BUILD & CACHE
# ============================================

# Dart tool
.dart_tool/

# Pub cache
.pub-cache/
.pub/

# Build outputs
/build/
**/build/

# Coverage
/coverage/

# Documentation
**/doc/api/

# ============================================
# ANDROID - Generated files with local paths
# ============================================

# Local properties (CRITICAL - contains SDK path with username)
**/local.properties

# Gradle
.gradle/
**/gradle-wrapper.jar
**/gradlew
**/gradlew.bat
**/.cxx/

# Build artifacts
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/captures/

# Generated plugin registrant
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.kt

# ============================================
# SIGNING KEYS & SECRETS (CRITICAL - NEVER COMMIT)
# ============================================

# Keystore files
*.keystore
*.jks
*.p12
*.pfx

# Key properties (contains passwords)
**/key.properties
key.properties

# Base64 encoded keystores (generated by scripts)
*.b64
*.b64.txt
*-keystore.b64*

# Signing configuration
signing/
.signing/

# ============================================
# iOS - Generated files with local paths
# ============================================

# Xcode user data (contains local paths)
**/xcuserdata/
*.xcuserstate

# Generated config (CRITICAL - contains full project path with username)
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/.last_build_id

# Ephemeral files (contain local paths)
**/ios/Flutter/ephemeral/

# Pods (will be regenerated)
**/ios/Pods/
**/ios/.symlinks/
**/ios/Podfile.lock

# Flutter generated
**/ios/Flutter/App.framework/
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*

# Xcode build
**/DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.moved-aside
**/*sync/
.sconsign.dblite
.tags*

# ============================================
# macOS - Generated files with local paths
# ============================================

# Ephemeral (CRITICAL - contains paths with username)
**/macos/Flutter/ephemeral/

# Pods
**/macos/Pods/
**/macos/Podfile.lock

# Generated
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Xcode
**/macos/**/*.xcuserdata/
**/macos/**/xcuserdata/
**/macos/**/DerivedData/

# ============================================
# LINUX - Generated files
# ============================================

**/linux/flutter/ephemeral/
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# ============================================
# WINDOWS - Generated files
# ============================================

**/windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates
x64/
x86/
*.[Cc]ache
!*.[Cc]ache/

# ============================================
# WEB - Build files
# ============================================

**/web/.dart_tool/

# ============================================
# MISC BUILD & DEBUG FILES
# ============================================

# Symbolication
app.*.symbols

# Obfuscation
app.*.map.json

# Logs
*.log

# Compiled files
*.class
*.pyc
*.o
*.so

# Version control
.svn/
.hg/

# Swift Package Manager
.swiftpm/
.build/
.buildlog/

# Migration
migrate_working_dir/

# History
.history

# Vagrant
**/.vagrant/

# documentation files
docfiles/

# ============================================
# CI/CD GENERATED FILES
# ============================================

# GitHub Actions local test files
.act/
act.json

# Environment files
.env
.env.*
!.env.example

# ============================================
# SCRIPTS OUTPUT
# ============================================

# Generated keystore files from scripts
scripts/*.jks
scripts/*.keystore
scripts/*.b64
scripts/*.b64.txt

